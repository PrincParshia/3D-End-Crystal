{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/PrincParshia/3D-End-Crystal"
    },
    "license": "${license}",
    "icon": "${mod_id}.icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "princ.tdendcrystal.client.TDEndCrystal"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=${minecraft_version_min} <=${minecraft_version_max}",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.modrinth": "https://modrinth.com/mod/td-end-crystal",
                "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/td-end-crystal",
                "modmenu.kofi": "https://ko-fi.com/princparshia"
            }
        }
    }
}
  